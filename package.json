{
  "name": "charades-game",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist-server/index.mjs",
    "build": "vite build && vite build --ssr server/index.ts",
    "preview": "vite preview",
